# Copy to .env.local for development, and set the same values in Vercel
# (Project → Settings → Environment Variables).
#
# Both are read only on the server, inside the enquiry Server Action. Do not
# prefix them with NEXT_PUBLIC_ — that would ship the token to the browser
# and let anyone write rows to the sheet.

# Deployment URL of the Apps Script web app.
# Apps Script → Deploy → New deployment → Web app → copy the /exec URL.
ENQUIRY_WEBHOOK_URL=

# Must match SHARED_TOKEN in google-apps-script/enquiry-webhook.gs.
# Any long random string, e.g. `openssl rand -hex 24`.
ENQUIRY_WEBHOOK_TOKEN=
