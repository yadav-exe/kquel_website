# Copy to .env.local for development, and set the same values in Vercel
# (Project → Settings → Environment Variables).
#
# Both are read only on the server, inside the enquiry Server Action. Do not
# prefix them with NEXT_PUBLIC_ — that would ship the token to the browser
# and let anyone write rows to the sheet.

# Deployment URL of the Apps Script web app.
# Apps Script → Deploy → New deployment → Web app → copy the /exec URL.
ENQUIRY_WEBHOOK_URL=

# Must match SHARED_TOKEN in google-apps-script/enquiry-webhook.gs.
# Any long random string, e.g. `openssl rand -hex 24`.
ENQUIRY_WEBHOOK_TOKEN=

# --- Content (Sanity) ---------------------------------------------------
# Project id and dataset from sanity.io/manage. Both are public: the Studio
# in the browser needs them, so NEXT_PUBLIC_ is correct here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Viewer token (Manage → API → Tokens). Server-only. Lets editors preview
# unpublished changes on the site. The site works without it.
SANITY_API_READ_TOKEN=

# Any long random string. Set the same value on the webhook in
# Manage → API → Webhooks so /api/revalidate can trust the call.
SANITY_REVALIDATE_SECRET=

# Editor/write token, used only by `npm run seed` to load the catalogue
# and images into a fresh project. Not needed by the site. Delete after
# seeding — or skip it and run `npx sanity login` then
# `npx sanity exec scripts/seed-sanity.ts --with-user-token`.
SANITY_API_WRITE_TOKEN=
